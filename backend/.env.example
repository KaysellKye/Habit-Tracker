# Port server backend
PORT=5000

# Secret key untuk penandatanganan JWT token
JWT_SECRET=timeblock_jwt_super_secret_key_2026

# Opsional: Google OAuth Client ID untuk verifikasi login Google resmi
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ============================================================
# KONFIGURASI EMAIL SMTP GMAIL (Untuk Pengiriman OTP Nyata)
# ============================================================
# Alamat email Gmail yang digunakan untuk mengirim kode OTP
SMTP_EMAIL=your-email@gmail.com

# 16-karakter Sandi Aplikasi (App Password) dari Akun Google Anda
# PENTING: BUKAN kata sandi login biasa akun Google Anda!
# Cara membuat Sandi Aplikasi Gmail:
# 1. Buka https://myaccount.google.com/security
# 2. Pastikan 'Verifikasi 2 Langkah' (2-Step Verification) sudah AKTIF
# 3. Cari menu 'Sandi Aplikasi' (App Passwords)
# 4. Beri nama aplikasi (misal: "Habit Tracker OTP") lalu klik 'Buat' (Generate)
# 5. Salin 16 karakter yang dihasilkan (tanpa spasi) ke bawah ini:
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Nama pengirim yang tampil di email penerima (Opsional)
SMTP_FROM_NAME=Habit Tracker

# (Opsional) Jika menggunakan SMTP selain Gmail (misal: mail.domainanda.com)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

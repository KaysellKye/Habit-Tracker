{
  "name": "timeblock-todo-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TimeBlock To-Do Monorepo - Time-blocking to-do list with Google Calendar integration",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "keywords": [
    "timeblock",
    "todo",
    "calendar",
    "productivity"
  ],
  "author": "",
  "license": "ISC"
}
